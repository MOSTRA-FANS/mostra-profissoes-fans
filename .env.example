# ============================================================
# Amostra de Profissões — Backend
# Copie este arquivo para ".env" e ajuste os valores.
#   cp .env.example .env
# ============================================================

# --- Servidor -------------------------------------------------
# Ambiente: development | production | test
NODE_ENV=development
PORT=3000

# --- CORS -----------------------------------------------------
# Domínio(s) do frontend autorizado(s) a consumir a API.
# Separe múltiplos domínios por vírgula, sem barra final.
# Em produção esta variável é OBRIGATÓRIA.
CLIENT_ORIGIN=http://localhost:5500,http://127.0.0.1:5500

# --- Proxy reverso --------------------------------------------
# Quantidade de proxies confiáveis à frente da aplicação
# (Nginx, Render, Heroku, Cloudflare...). Necessário para o rate
# limiter enxergar o IP real do cliente.
#   0 = sem proxy | 1 = um proxy | true = confiar em todos (evite)
TRUST_PROXY=0

# --- Rate Limiting --------------------------------------------
# Limite GLOBAL (todas as rotas /api): 100 requisições / 15 min por IP
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Limite ESTRITO para o envio de inscrições (POST /api/subscriptions):
# 5 tentativas / 1 hora por IP
SUBSCRIPTION_RATE_LIMIT_WINDOW_MS=3600000
SUBSCRIPTION_RATE_LIMIT_MAX=5

# --- Logs -----------------------------------------------------
# Nível mínimo: error | warn | info | debug
LOG_LEVEL=info

# --- Banco de dados -------------------------------------------
# (variáveis de conexão ficam sob responsabilidade da Pessoa 2)
